{
  "name": "checkout-release-passport",
  "version": "0.4.1",
  "description": "Local-first checkout script control, monitoring evidence, review alerts, and release gating.",
  "type": "module",
  "private": true,
  "bin": {
    "checkout-evidence": "./src/cli.js"
  },
  "scripts": {
    "test": "node --test",
    "test:browser": "node --test verification/browser-readiness.mjs",
    "practice": "node examples/functional-practice/server.mjs",
    "practice:proof": "node scripts/verify-functional-demo.mjs",
    "practice:watch": "node scripts/verify-functional-demo.mjs --headed",
    "practice:healthy": "node scripts/verify-functional-demo.mjs --mode=healthy",
    "practice:broken": "node scripts/verify-functional-demo.mjs --mode=broken",
    "demo:v1": "node scripts/demo-server.js --version 1",
    "demo:v2": "node scripts/demo-server.js --version 2",
    "baseline:demo": "node src/cli.js baseline --config examples/demo-target.json --ack-authorized",
    "check:demo": "node src/cli.js check --config examples/demo-target.json --ack-authorized --no-fail",
    "verify:passport": "bash scripts/verify-passport-demo.sh",
    "verify:monitoring": "bash scripts/verify-passport-demo.sh"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "parse5": "7.3.0",
    "playwright": "1.64.1"
  }
}
